!lib/data/db/database.g.dart

# IDE
.idea/
.vscode/
*.iml

# Android
android/.gradle/
android/local.properties
android/key.properties
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
!android/gradle/wrapper/gradle-wrapper.jar

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# macOS
.DS_Store

# Backups exported by the app (never commit PII)
*.douu
*.douubak

# Local agent/session files and runtime diagnostics can include machine paths
# or app data. They do not belong in the public source repository.
.claude/
logs/
*.iml
