# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.lock.bak

# Generated code (regenerated via build_runner)
*.g.dart
*.freezed.dart
